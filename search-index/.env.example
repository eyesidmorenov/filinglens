# search-index variables (same names as the team repo). No secrets.
# With IndexSettings.from_env(prefix="SEARCH_") they are read with that prefix (SEARCH_ES_INDEX...).

# Inside Compose: http://elasticsearch:9200
ELASTICSEARCH_URL=http://localhost:9200
# Index created and filled by the team loader (index/src/load.py)
ES_INDEX=filinglens-chunks
# Dimensions of BAAI/bge-base-en-v1.5; health() warns if the index has a different size
EMBEDDING_DIMS=768

# Credentials: only if Elasticsearch has security enabled. Empty locally; NEVER commit them.
ELASTIC_API_KEY=
ELASTIC_API_KEY_ID=
